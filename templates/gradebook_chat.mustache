<input type="hidden" id="block-ai-assistant-gradebook-courseid" value="{{courseid}}">
<input type="hidden" id="block-ai-assistant-gradebook-userid" value="{{userid}}">
<input type="hidden" id="block-ai-assistant-gradebook-botname" value="{{botname}}">
<input type="hidden" id="block-ai-assistant-gradebook-sessionid" value="">

<style>
    /* Make the page a fixed-height flex column so chat + mapping + input share vertical space nicely. */
    #region-main {
        height: auto;
        min-height: calc(100vh - 220px);
        max-height: calc(100vh - 220px);
        position: relative;
        overflow: hidden;
    }

    .gradebook-container {
        height: calc(100vh - 220px);
        max-height: calc(100vh - 220px);
        display: flex;
        flex-direction: column;
        background: var(--bs-body-bg, #ffffff);
        border-radius: 10px;
        border: 1px solid var(--bs-border-color, #dee2e6);
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    }

    .gradebook-card {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        height: 100%;
        border: none;
        border-radius: 10px;
        min-height: 0;
    }

    /* Header. */
    .gradebook-header {
        background: var(--bs-info-bg-subtle, #cff4fc);
        border: 1px solid var(--bs-info-border-subtle, #9eeaf9);
        color: var(--bs-info-text-emphasis, #055160);
        border-radius: 10px 10px 0 0;
        margin: 0;
        padding: 10px 16px;
        font-size: 14px;
        flex-shrink: 0;
    }

    /* Chat scroll area. */
    .chat-messages {
        flex: 1 1 auto;
        overflow-y: auto;
        min-height: 160px;
        padding: 16px 20px;
        background: var(--bs-tertiary-bg, #f8f9fa);
        scrollbar-width: thin;
        scrollbar-color: #c1c1c1 transparent;
    }

    .chat-message {
        display: flex;
        margin-bottom: 16px;
        align-items: flex-start;
        gap: 12px;
    }

    .bot-message { justify-content: flex-start; }
    .human-message { justify-content: flex-end; }

    .message-content {
        max-width: 75%;
        padding: 10px 14px;
        border-radius: 16px;
        font-size: 14px;
        line-height: 1.5;
        word-wrap: break-word;
        white-space: pre-wrap;
        position: relative;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
    }

    .bot-message .message-content {
        background: var(--bs-body-bg, #ffffff);
        color: var(--bs-body-color, #212529);
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-bottom-left-radius: 4px;
    }

    .message-content code,
    .message-content .gradebook-inline-code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
        font-size: 0.92em;
        padding: 1px 5px;
        border-radius: 4px;
        background: var(--bs-tertiary-bg, #f1f3f5);
        border: 1px solid var(--bs-border-color-translucent, rgba(0, 0, 0, 0.08));
        white-space: normal;
        word-break: break-word;
    }

    .message-content pre.gradebook-proposal-tree {
        margin: 12px 0 14px;
        padding: 14px 16px;
        line-height: 1.42;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
        font-size: 13px;
        white-space: pre;
        background: var(--bs-tertiary-bg, #f8f9fa);
        border: 1px solid var(--bs-border-color-translucent, rgba(0, 0, 0, 0.1));
        border-radius: 10px;
        overflow-x: auto;
        color: var(--bs-body-color, #212529);
        letter-spacing: 0.01em;
        tab-size: 4;
    }

    .human-message .message-content {
        background: var(--bs-primary, #0d6efd);
        color: var(--bs-white, #ffffff);
        border-bottom-right-radius: 4px;
        margin-left: auto;
    }

    /* Mapping preview drawer — collapsible, compact, its own scroll. */
    .gradebook-mapping-drawer {
        border-top: 1px solid var(--bs-border-color, #dee2e6);
        background: var(--bs-body-bg, #ffffff);
        flex-shrink: 0;
    }

    .gradebook-mapping-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 14px;
        font-size: 13px;
        color: var(--bs-body-color, #212529);
        cursor: pointer;
        user-select: none;
        background: var(--bs-tertiary-bg, #f8f9fa);
    }

    .gradebook-mapping-header:hover {
        background: var(--bs-secondary-bg, #e9ecef);
    }

    .gradebook-mapping-header .chevron {
        transition: transform 0.2s ease;
    }

    .gradebook-mapping-drawer.is-collapsed .chevron {
        transform: rotate(-90deg);
    }

    .gradebook-mapping-body {
        padding: 10px 14px 12px 14px;
        max-height: 34vh;
        overflow-y: auto;
    }

    .gradebook-mapping-drawer.is-collapsed .gradebook-mapping-body {
        display: none;
    }

    #gradebook-mapping-table-wrapper {
        max-height: 26vh;
        overflow-y: auto;
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 10px;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);
    }

    #gradebook-mapping-table-wrapper table {
        margin-bottom: 0;
    }

    #gradebook-mapping-table-wrapper thead th {
        position: sticky;
        top: 0;
        background: linear-gradient(180deg, var(--bs-secondary-bg, #e9ecef), var(--bs-tertiary-bg, #f8f9fa));
        z-index: 1;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--bs-secondary-color, #6c757d);
        border-bottom: 1px solid var(--bs-border-color, #dee2e6);
    }

    #gradebook-mapping-table-wrapper tbody td {
        vertical-align: middle;
    }

    #gradebook-mapping-table-wrapper tbody tr:nth-child(even):not(.gradebook-row-not-graded) {
        background: rgba(13, 110, 253, 0.02);
    }

    .gradebook-row-not-graded .gradebook-activity-name {
        color: var(--bs-secondary-color, #6c757d);
        text-decoration: line-through;
        text-decoration-thickness: 1px;
    }
    .gradebook-row-not-graded td {
        background: var(--bs-tertiary-bg, #f8f9fa);
    }

    .gradebook-row-missing td {
        background: rgba(220, 53, 69, 0.08);
    }

    .gradebook-row-missing .gradebook-category-select {
        border-color: var(--bs-danger, #dc3545);
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.15);
    }

    .gradebook-category-select {
        min-width: 150px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .gradebook-subcategory-select {
        min-width: 160px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .gradebook-subcategory-select:disabled {
        opacity: 0.8;
        cursor: not-allowed;
        background: var(--bs-tertiary-bg, #f8f9fa);
    }

    .gradebook-mapping-help {
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-left: 3px solid var(--bs-primary, #0d6efd);
        background: var(--bs-body-bg, #ffffff);
        border-radius: 8px;
        padding: 8px 10px;
        font-size: 12px;
        color: var(--bs-secondary-color, #6c757d);
    }

    .gradebook-mapping-help strong {
        color: var(--bs-body-color, #212529);
        font-weight: 600;
    }

    .gradebook-select-empty {
        color: var(--bs-secondary-color, #6c757d);
    }

    /* Error highlight and shake effect. */
    .gradebook-error-shake {
        animation: shake 0.4s cubic-bezier(.36,.07,.19,.97) both;
        transform: translate3d(0, 0, 0);
    }

    @keyframes shake {
        10%, 90% { transform: translate3d(-1px, 0, 0); }
        20%, 80% { transform: translate3d(2px, 0, 0); }
        30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
        40%, 60% { transform: translate3d(4px, 0, 0); }
    }

    .gradebook-mapping-error-alert {
        border-left: 4px solid var(--bs-danger, #dc3545);
        background: var(--bs-danger-bg-subtle, #f8d7da);
        color: var(--bs-danger-text-emphasis, #842029);
        font-size: 13px;
        padding: 8px 12px;
        margin-bottom: 10px;
        border-radius: 4px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Result panel — success banner shown after finalize. */
    #gradebook-result-panel {
        background: var(--bs-success-bg-subtle, #d1e7dd);
        border: 1px solid var(--bs-success-border-subtle, #a3cfbb);
        color: var(--bs-success-text-emphasis, #0a3622);
        border-radius: 0;
        margin: 0;
        padding: 10px 16px;
        flex-shrink: 0;
    }

    /* Modern input bar. */
    .gradebook-input-bar {
        background: var(--bs-body-bg, #ffffff);
        border-top: 1px solid var(--bs-border-color, #dee2e6);
        padding: 10px 14px;
        flex-shrink: 0;
    }

    .gradebook-input-wrap {
        display: flex;
        align-items: center;
        background: var(--bs-tertiary-bg, #f8f9fa);
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 24px;
        padding: 4px 4px 4px 16px;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .gradebook-input-wrap:focus-within {
        border-color: var(--bs-primary, #0d6efd);
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.15);
    }

    #block-ai-assistant-gradebook-input {
        flex: 1 1 auto;
        border: 0;
        outline: 0;
        background: transparent;
        padding: 8px 4px;
        font-size: 14px;
        min-width: 0;
    }

    #block-ai-assistant-gradebook-input:focus {
        box-shadow: none;
    }

    #block-ai-assistant-gradebook-send-btn {
        flex: 0 0 auto;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 0;
        background: var(--bs-primary, #0d6efd);
        color: #ffffff;
        transition: background 0.15s ease, transform 0.1s ease;
    }

    #block-ai-assistant-gradebook-send-btn:hover:not(:disabled) {
        background: var(--bs-primary-rgb, #0b5ed7);
        transform: scale(1.05);
    }

    #block-ai-assistant-gradebook-send-btn:disabled {
        background: var(--bs-secondary, #6c757d);
        opacity: 0.6;
        cursor: not-allowed;
    }

    #block-ai-assistant-gradebook-send-btn svg {
        width: 18px;
        height: 18px;
    }

    .gradebook-icon-btn {
        flex: 0 0 auto;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 0;
        background: var(--bs-secondary, #6c757d);
        color: #ffffff;
        transition: background 0.15s ease, transform 0.1s ease;
        margin-right: 4px;
        cursor: pointer;
    }

    .gradebook-icon-btn:hover:not(:disabled) {
        background: var(--bs-secondary-hover, #565e64);
        transform: scale(1.05);
    }

    .gradebook-icon-btn:disabled {
        background: var(--bs-secondary, #6c757d);
        opacity: 0.6;
        cursor: not-allowed;
    }

    .gradebook-icon-btn svg {
        width: 18px;
        height: 18px;
    }

    .gradebook-action-active {
        background: var(--bs-danger, #dc3545) !important;
        border-color: var(--bs-danger, #dc3545) !important;
        color: var(--bs-white, #ffffff) !important;
    }

    .gradebook-action-active:hover,
    .gradebook-action-active:focus {
        background: var(--bs-danger-text-emphasis, #842029) !important;
        border-color: var(--bs-danger-text-emphasis, #842029) !important;
        color: var(--bs-white, #ffffff) !important;
    }

    .gradebook-action-complete {
        background: var(--bs-success, #198754) !important;
        border-color: var(--bs-success, #198754) !important;
        color: var(--bs-white, #ffffff) !important;
    }

    .gradebook-action-complete:hover,
    .gradebook-action-complete:focus {
        background: var(--bs-success-text-emphasis, #0f5132) !important;
        border-color: var(--bs-success-text-emphasis, #0f5132) !important;
        color: var(--bs-white, #ffffff) !important;
    }

    @media (max-width: 991px) {
        #gradebook-mapping-table-wrapper {
            max-height: 32vh;
        }

        .gradebook-category-select,
        .gradebook-subcategory-select {
            min-width: 130px;
            font-size: 12px;
        }
    }

    @media (max-width: 767px) {
        .gradebook-mapping-body {
            padding: 8px 10px 10px 10px;
        }

        #gradebook-mapping-table-wrapper table {
            min-width: 680px;
        }
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="gradebook-container">
            <div class="card gradebook-card">

                <div class="gradebook-header">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="fw-semibold">{{#str}}gradebook, block_ai_assistant{{/str}}</div>
                            <span class="me-2">Phase:</span><span id="gradebook-phase-badge" class="badge bg-secondary">—</span>
                        </div>
                        <div class="btn-group btn-group-sm" role="group" aria-label="Gradebook actions">
                            <button type="button" class="btn btn-outline-primary" id="btn-gradebook-proposal" data-stage="proposal">
                                Proposal
                            </button>
                            <button type="button" class="btn btn-outline-primary" id="btn-gradebook-accept" data-stage="accept">
                                Generate mapping
                            </button>
                            <button type="button" class="btn btn-outline-primary" id="btn-gradebook-finalize" data-stage="finalize">
                                Finalize
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="btn-gradebook-reset"
                                    title="{{#str}}gradebook_reset_session_tooltip, block_ai_assistant{{/str}}">
                                {{#str}}gradebook_reset_session, block_ai_assistant{{/str}}
                            </button>
                            <button type="button" class="btn btn-outline-danger" id="btn-gradebook-delete"
                                    title="{{#str}}gradebook_delete_session_tooltip, block_ai_assistant{{/str}}">
                                {{#str}}gradebook_delete_session, block_ai_assistant{{/str}}
                            </button>
                            <button type="button" class="btn btn-danger d-none" id="btn-gradebook-revert"
                                    title="{{#str}}gradebook_revert_session_tooltip, block_ai_assistant{{/str}}">
                                {{#str}}gradebook_revert_session, block_ai_assistant{{/str}}
                            </button>
                        </div>
                    </div>
                    <div class="small mt-1">
                        <span class="me-2">Session:</span><code id="gradebook-session-badge">starting…</code>
                    </div>
                </div>

                <div id="gradebook-result-panel" class="d-none" role="region" aria-label="Gradebook finalize result">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                        <div class="fw-semibold mb-0">{{#str}}gradebook_result_heading, block_ai_assistant{{/str}}</div>
                        <div class="btn-group btn-group-sm">
                            <a href="#" class="btn btn-outline-primary" id="btn-gradebook-open-setup">
                                {{#str}}gradebook_open_setup, block_ai_assistant{{/str}}
                            </a>
                            <button type="button" class="btn btn-outline-success" id="btn-gradebook-download-word">
                                {{#str}}gradebook_download_word, block_ai_assistant{{/str}}
                            </button>
                            <button type="button" class="btn btn-outline-success" id="btn-gradebook-download-pdf">
                                {{#str}}gradebook_download_pdf, block_ai_assistant{{/str}}
                            </button>
                        </div>
                    </div>
                    <div id="gradebook-result-summary" class="small"></div>
                </div>

                <div id="gradebook-chat-messages" class="chat-messages">
                    <!-- Messages inserted by JS -->
                </div>

                <div id="gradebook-mapping-drawer" class="gradebook-mapping-drawer is-collapsed">
                    <div class="gradebook-mapping-header" id="gradebook-mapping-toggle" role="button"
                         tabindex="0" aria-expanded="false" aria-controls="gradebook-mapping-body">
                        <span class="d-flex align-items-center gap-2">
                            <svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                                <path d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/>
                            </svg>
                            <span class="fw-semibold">{{#str}}gradebook_mapping_preview, block_ai_assistant{{/str}}</span>
                            <span class="badge bg-secondary" id="gradebook-mapping-count" title="graded / total">0</span>
                        </span>
                        <span class="small text-muted d-none d-md-inline">
                            {{#str}}gradebook_mapping_hint, block_ai_assistant{{/str}}
                        </span>
                    </div>

                    <div class="gradebook-mapping-body" id="gradebook-mapping-body">
                        <div id="gradebook-mapping-error" class="gradebook-mapping-error-alert d-none" role="alert">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-exclamation-triangle-fill flex-shrink-0" viewBox="0 0 16 16">
                                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                            </svg>
                            <div id="gradebook-mapping-error-text"></div>
                        </div>

                        <div id="gradebook-mapping-empty" class="alert alert-secondary py-2 small mb-2">
                            {{#str}}gradebook_mapping_empty, block_ai_assistant{{/str}}
                        </div>

                        <div id="gradebook-mapping-table-wrapper" class="table-responsive d-none">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                <tr>
                                    <th style="width: 60px">CMID</th>
                                    <th>Activity</th>
                                    <th style="width: 180px">Category</th>
                                    <th style="width: 180px">Subcategory</th>
                                </tr>
                                </thead>
                                <tbody id="gradebook-mapping-rows"></tbody>
                            </table>
                        </div>

                        <div class="gradebook-mapping-help mt-2" id="gradebook-mapping-help">
                            <strong>Mapping tip:</strong>
                            choose a top-level category first, then optionally choose a subcategory.
                            Leaving subcategory as "None" keeps the item directly under the parent category.
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                            <button class="btn btn-link btn-sm p-0" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#gradebook-advanced" aria-expanded="false" aria-controls="gradebook-advanced">
                                Advanced Options
                            </button>
                            <button type="button" class="btn btn-success btn-sm" id="btn-gradebook-generate"
                                    title="{{#str}}gradebook_generate_title, block_ai_assistant{{/str}}">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" class="me-1" aria-hidden="true">
                                    <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/>
                                </svg>
                                {{#str}}gradebook_generate, block_ai_assistant{{/str}}
                            </button>
                        </div>
                        <div class="collapse mt-2" id="gradebook-advanced">
                            <div class="mb-3">
                                <label for="gradebook-excel-formula" class="form-label">Excel-Style Formula</label>
                                <input type="text" id="gradebook-excel-formula" class="form-control form-control-sm"
                                       placeholder="e.g., =average([[hw1]],[[hw2]]) or =([[midterm]]*0.3)+([[final]]*0.7)"
                                       aria-label="Excel-style formula for grade calculation">
                                <small class="text-muted d-block mt-1">
                                    Use Moodle refs like [[item_id]]. Supported operators: + - * / () and comma separators.
                                    <a href="#" data-bs-toggle="modal" data-bs-target="#formula-help-modal" class="ms-1">Learn more</a>
                                </small>
                            </div>
                            <div class="mb-2">
                                <label for="gradebook-confirmed-mapping" class="form-label">JSON Configuration</label>
                                <textarea id="gradebook-confirmed-mapping" class="form-control form-control-sm" rows="5"
                                          placeholder='[{"moodle_cmid":101,"category":"Assignments","subcategory":"Homework"}]'></textarea>
                                <small class="text-muted d-block mt-1">
                                    Synced with the table above. Rows with category "{{#str}}gradebook_not_graded, block_ai_assistant{{/str}}" are excluded from Finalize.
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="gradebook-input-bar">
                    <form id="gradebook-chat-form" method="post" action="gradebook.php" onsubmit="return false;">
                        <input type="hidden" name="courseid" value="{{courseid}}">
                        <div class="gradebook-input-wrap">
                            <input type="text"
                                   id="block-ai-assistant-gradebook-input"
                                   placeholder="{{#str}}gradebook_input_placeholder, block_ai_assistant{{/str}}"
                                   autocomplete="off"
                                   aria-label="{{#str}}gradebook_input_placeholder, block_ai_assistant{{/str}}">
                            <input type="file"
                                   id="gradebook-file-upload-input"
                                   style="display: none;"
                                   accept=".pdf,.doc,.docx,.txt,.xlsx,.xls"
                                   aria-label="Upload syllabus or grading document">
                            <button type="button" id="gradebook-file-upload-btn"
                                    class="gradebook-icon-btn"
                                    aria-label="Upload document (PDF, Word, or text)"
                                    title="Upload syllabus or grading document">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                                </svg>
                            </button>
                            <button type="button" id="block-ai-assistant-gradebook-send-btn"
                                    aria-label="{{#str}}gradebook_send, block_ai_assistant{{/str}}"
                                    title="{{#str}}gradebook_send, block_ai_assistant{{/str}}">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M3.4 20.4 20.85 12.92a1 1 0 0 0 0-1.84L3.4 3.6a1 1 0 0 0-1.39 1.19L4 11l8 1-8 1-1.99 6.21a1 1 0 0 0 1.39 1.19Z"/>
                                </svg>
                            </button>
                        </div>
                    </form>
                    <div id="gradebook-upload-progress" class="d-none" style="margin-top: 8px;">
                        <div class="progress" style="height: 4px;">
                            <div id="gradebook-upload-progress-bar" class="progress-bar bg-success" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <small class="text-muted" id="gradebook-upload-status">Uploading...</small>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Excel Formula Help Modal -->
<div class="modal fade" id="formula-help-modal" tabindex="-1" aria-labelledby="formula-help-label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="formula-help-label">Excel-Style Formula Syntax</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <h6 class="mb-2">Basic Format</h6>
                    <p class="small mb-2">Use Moodle double square brackets to reference item IDs:</p>
                    <code class="d-block bg-light p-2 mb-2">[[item_id]]</code>
                    <p class="small mb-0 text-muted">Legacy single-bracket input like [item] is accepted and normalized.</p>
                </div>

                <div class="mb-3">
                    <h6 class="mb-2">Supported Operators</h6>
                    <ul class="small mb-0">
                        <li><code>+</code> Addition</li>
                        <li><code>-</code> Subtraction</li>
                        <li><code>*</code> Multiplication</li>
                        <li><code>/</code> Division</li>
                        <li><code>( )</code> Parentheses for grouping</li>
                    </ul>
                </div>

                <div class="mb-3">
                    <h6 class="mb-2">Examples</h6>
                    <div class="small">
                        <div class="mb-2">
                            <strong>Simple Average:</strong><br>
                            <code class="d-block bg-light p-2">=average([[hw1]],[[hw2]],[[hw3]])</code>
                        </div>
                        <div class="mb-2">
                            <strong>Weighted Average:</strong><br>
                            <code class="d-block bg-light p-2">=([[midterm]]*0.3)+([[final]]*0.7)</code>
                        </div>
                        <div class="mb-2">
                            <strong>Nested Function:</strong><br>
                            <code class="d-block bg-light p-2">=round(average([[q1]],[[q2]]),2)</code>
                        </div>
                        <div>
                            <strong>Conditional:</strong><br>
                            <code class="d-block bg-light p-2">=if([[bonus]]&gt;0, [[score]]+[[bonus]], [[score]])</code>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info small mb-0">
                    <strong>Tip:</strong> Formulas are used to calculate final grades in the generated gradebook.
                    Use Moodle's built-in grade calculation features for more advanced scenarios.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
