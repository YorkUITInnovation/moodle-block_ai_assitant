#############################################
# FastAPI LTI AI Assistant - Environment File
# Copy/rename to .env (already named) and adjust values as needed.
# Uvicorn (with python-dotenv) will auto-load this.
#############################################

############################
# Core Server / Environment
############################
APP_ENV=development              # Set to 'production' in prod deployments
API_KEY=test                     # REQUIRED in production: replace with a long random string
TOOL_HOST=http://localhost:8000  # Public base URL of this FastAPI tool (used for LTI redirect_uri)

############################
# LTI Operation Modes
############################
LTI_DEMO_MODE=1                  # 1 = disable signature verification (dev); 0 = verify signatures
LTI_STRICT=0                     # 1 = enforce exp/iat/nonce/aud rigorously
STATE_TTL_SECONDS=300
NONCE_TTL_SECONDS=300
JWK_TTL_SECONDS=3600             # Ephemeral tool key rotation interval (seconds)
JWT_LEEWAY_SECONDS=30            # Allowed clock skew
JWT_IAT_MAX_AGE_SECONDS=300      # Max age for iat when strict

############################
# Persistence / Database
############################
LTI_PERSIST=1                    # 1 = enable DB persistence for launches & state/nonce
# Default to local SQLite (dev). For production, strongly prefer MySQL below.
LTI_DB_URL=sqlite:///./lti_scaffold.db
# Example MySQL DSN (uncomment & edit):
# LTI_DB_URL=mysql+pymysql://lti_user:STRONG_PASSWORD@localhost:3306/lti_db?charset=utf8mb4
LTI_USE_MIGRATIONS=1             # Use Alembic migrations instead of metadata.create_all
LTI_AUTO_MIGRATE=1               # Auto-run upgrade head on startup (disable in strict prod CI/CD)

############################
# CRIA Service Configuration
############################
CRIA_BASE_URL=http://localhost:9001     # Base URL of CRIA backend
CRIA_API_TOKEN=                         # Bearer token for CRIA (optional)
CRIA_EMBED_URL=                         # If using CRIA embed script hosting
CRIA_DEFAULT_SYSTEM_MESSAGE=Course [course_number]: [course_title]
CRIA_DEFAULT_NO_CONTEXT_MESSAGE=No context available
CRIA_BOT_TITLE=AI Assistant
CRIA_BOT_DESCRIPTION=Course assistant bot
CRIA_BOT_TYPE=COURSE
CRIA_MODEL_ID=default-model
CRIA_EMBEDDING_ID=default-embed
CRIA_RERANK_MODEL_ID=default-rerank
CRIA_REQUIRES_CONTENT_PROMPT=0
CRIA_REQUIRES_USER_PROMPT=0
CRIA_USER_PROMPT=
CRIA_WELCOME_MESSAGE=Hello!
CRIA_THEME_COLOR=#0055A5
CRIA_MAX_TOKENS=2048
CRIA_TEMPERATURE=0.7
CRIA_TOP_P=1.0
CRIA_TOP_K=50
CRIA_TOP_N=1
CRIA_MIN_K=3
CRIA_MIN_RELEVANCE=0.3
CRIA_MAX_CONTEXT=20
CRIA_NO_CONTEXT_USE_MESSAGE=0
CRIA_NO_CONTEXT_LLM_GUESS=0
CRIA_AVAILABLE_CHILD=0
CRIA_PARSE_STRATEGY=GENERIC
CRIA_WATERMARK=0
CRIA_BOT_SUBTITLE=
CRIA_EMBED_POSITION=bottom-right
CRIA_BOT_LOCALE=en
CRIA_CHILD_BOTS=
CRIA_PUBLISH_ON_CREATE=0
CRIA_BOT_CONTACT=
CRIA_BOT_HELP_TEXT=
CRIA_LOGO_PATH=                    # Absolute path to a PNG to override default logo (optional)

############################
# Legacy / Optional
############################
# DOCS_API_KEY=                  # Deprecated: docs endpoints removed

############################
# Logging / Misc (add as needed)
############################
# LOG_LEVEL=info

#############################################
# Production Hardening Checklist (reference)
# 1. Set APP_ENV=production
# 2. Set API_KEY to a strong random value (>=32 chars)
# 3. Set TOOL_HOST to the public HTTPS URL
# 4. Set LTI_DEMO_MODE=0 and decide if LTI_STRICT=1
# 5. Use MySQL DSN for LTI_DB_URL; run Alembic migrations via CI
# 6. Disable LTI_AUTO_MIGRATE in runtime containers (handle migrations pre-deploy)
# 7. Provide CRIA_API_TOKEN and secure network egress
#############################################

